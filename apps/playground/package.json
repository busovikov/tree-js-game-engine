{
  "name": "@haku/playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ui-m1": "vite --config vite.ui-m1.config.ts",
    "build": "tsc && vite build",
    "build:ui-m1": "vite build --config vite.ui-m1.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@haku/audio": "workspace:*",
    "@haku/audio-web": "workspace:*",
    "@haku/assets": "workspace:*",
    "@haku/build": "workspace:*",
    "@haku/core": "workspace:*",
    "@haku/engine": "workspace:*",
    "@haku/graph": "workspace:^",
    "@haku/graph-runtime": "workspace:^",
    "@haku/pool": "workspace:*",
    "@haku/physics-rapier": "workspace:*",
    "@haku/platform": "workspace:*",
    "@haku/storage": "workspace:*",
    "@haku/ui": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
